import numpy as np
from sklearn.linear_model import LinearRegression

X = np.array([[1], [2], [3], [4], [5], [6]])
y = np.array([1000, 1500, 2000, 2500, 3000, 3500])

model = LinearRegression()
model.fit(X, y)

future = model.predict([[7], [8], [9]])

print("Future Sales Prediction:")
print(future)
