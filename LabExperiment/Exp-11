import pandas as pd
from sklearn.tree import DecisionTreeClassifier

data = {
    'Income': [25000, 40000, 55000, 70000, 30000,
               80000, 45000, 65000],
    'Debt': [18000, 10000, 8000, 5000, 20000,
             3000, 12000, 6000],
    'PaymentHistory': [2, 4, 5, 5, 1, 5, 3, 4],
    'Score': ['Low', 'Medium', 'High', 'High',
             'Low', 'High', 'Medium', 'High']
}

df = pd.DataFrame(data)

X = df[['Income', 'Debt', 'PaymentHistory']]
y = df['Score']

model = DecisionTreeClassifier()
model.fit(X, y)

print("Training Accuracy:", model.score(X, y))

new_data = [[60000, 7000, 4]]
print("Predicted Credit Score:", model.predict(new_data)[0])
